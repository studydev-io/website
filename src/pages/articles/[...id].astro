---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// 1. Розбираємо ID на слаг статті та піддиректорію перекладу.
//    Базова стаття (українська) лежить прямо в теці слага: id = "<slug>".
//    Переклад лежить у вкладеній теці: id = "<slug>/<lang>-<level>",
//    напр. "3-how-to-learn-programming/en-a2".
const [slug, variant] = article.id.split('/');
const isTranslation = Boolean(variant);
const isEnglish = isTranslation;

const allArticles = await getCollection('articles');

// 2. Базова (українська) стаття — для перекладу шукаємо оригінал за слагом
const baseArticle = isTranslation
  ? allArticles.find(a => a.id === slug)
  : article;

// 3. Усі перекладені версії цієї статті (можуть бути різних мовних рівнів)
const translations = allArticles
  .filter(a => a.id.startsWith(`${slug}/`))
  .sort((a, b) => a.id.localeCompare(b.id));
const otherTranslations = translations.filter(t => t.id !== article.id);

// 4. Людяна назва варіанту перекладу за кодом "<lang>-<level>"
const VARIANT_LABELS: Record<string, string> = {
  'en-a1': 'Simple English (A1)',
  'en-a2': 'Simple English (A2)',
  'en-b1': 'Intermediate English (B1)',
  'en-b2': 'Upper-Intermediate English (B2)',
  'en-c1': 'Advanced English (C1)',
  'en-c2': 'Advanced English (C2)',
};
function formatVariantLabel(variantId: string) {
  return VARIANT_LABELS[variantId] ?? variantId.toUpperCase();
}

// 5. Шукаємо mp3-файл аудіоверсії статті в тій же теці
const audioModules = import.meta.glob('/src/content/articles/**/*.mp3', {
  eager: true,
  query: '?url',
  import: 'default',
});
const articleDir = `/src/content/articles/${article.id}/`;
const audioSrc = Object.entries(audioModules).find(([path]) => {
  if (!path.startsWith(articleDir)) return false;
  // Файл має лежати саме в цій теці, а не в теці вкладеного перекладу
  return !path.slice(articleDir.length).includes('/');
})?.[1] as string | undefined;
---

<Layout title={article.data.title}>
  <div style="margin-bottom: 20px;">
    <a href="/articles">← {isEnglish ? 'Back to Articles' : 'Назад до списку статей'}</a>
  </div>

  <article>
    <header>
      <div>
        {isEnglish ? 'Published:' : 'Опубліковано:'} {article.data.pubDate.toLocaleDateString(isEnglish ? 'en-US' : 'uk-UA')}
      </div>

      {/* 4. Для перекладу — посилання на український оригінал */}
      {isTranslation && baseArticle && (
        <div>
          <strong>🌐 Оригінал українською:</strong>
          <br/>
          <a href={`/articles/${baseArticle.id}`}>
            {baseArticle.data.title}
          </a>
        </div>
      )}

      {/* Для базової статті — список усіх наявних перекладів (можуть бути різних рівнів) */}
      {!isTranslation && translations.length > 0 && (
        <div>
          <strong>🌐 Also available in translations:</strong>
          <ul>
            {translations.map(t => (
              <li>
                <a href={`/articles/${t.id}`}>{t.data.title}</a> ({formatVariantLabel(t.id.split('/')[1])})
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* Для перекладу — посилання на інші рівні/варіанти перекладу цієї ж статті */}
      {isTranslation && otherTranslations.length > 0 && (
        <div>
          <strong>Other levels:</strong>
          <ul>
            {otherTranslations.map(t => (
              <li>
                <a href={`/articles/${t.id}`}>{t.data.title}</a> ({formatVariantLabel(t.id.split('/')[1])})
              </li>
            ))}
          </ul>
        </div>
      )}
    </header>

    {audioSrc && (
      <div class="article-audio">
        <strong>{isEnglish ? '🎧 Listen to the audio version:' : '🎧 Аудіоверсія статті:'}</strong>
        <audio controls src={audioSrc}>
          {isEnglish ? 'Your browser does not support the audio element.' : 'Ваш браузер не підтримує аудіоелемент.'}
        </audio>
      </div>
    )}

    <div class="article-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .article-audio {
    margin: 20px 0;
    padding: 12px 16px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
  }

  .article-audio audio {
    display: block;
    width: 100%;
    margin-top: 8px;
  }
</style>