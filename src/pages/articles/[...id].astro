---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { id: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);

// 1. Визначаємо поточну мову
const isEnglish = article.id.startsWith('en/');

// 2. Формуємо ID для пошуку альтернативної версії
const altLangId = isEnglish 
  ? article.id.replace('en/', 'uk/') 
  : article.id.replace('uk/', 'en/');

// 3. Шукаємо, чи існує файл з таким ID
const allArticles = await getCollection('articles');
const altArticle = allArticles.find(a => a.id === altLangId);

// 5. Шукаємо mp3-файл аудіоверсії статті в тій же теці
const audioModules = import.meta.glob('/src/content/articles/**/*.mp3', {
  eager: true,
  query: '?url',
  import: 'default',
});
const audioSrc = Object.entries(audioModules).find(([path]) =>
  path.startsWith(`/src/content/articles/${article.id}/`)
)?.[1] as string | undefined;
---

<Layout title={article.data.title}>
  <div style="margin-bottom: 20px;">
    <a href="/articles">← {isEnglish ? 'Back to Articles' : 'Назад до списку статей'}</a>
  </div>

  <article>
    <header>
      <div>
        {isEnglish ? 'Published:' : 'Опубліковано:'} {article.data.pubDate.toLocaleDateString(isEnglish ? 'en-US' : 'uk-UA')}
      </div>

      {/* 4. Виводимо посилання на іншу мову, ТІЛЬКИ якщо файл існує */}
      {altArticle && (
        <div>
          <strong>{isEnglish ? '🌐 Також доступно українською:' : '🌐 Also available in Simple English:'}</strong>
          <br/>
          <a href={`/articles/${altArticle.id}`}>
            {altArticle.data.title}
          </a>
        </div>
      )}
    </header>

    {audioSrc && (
      <div class="article-audio">
        <strong>{isEnglish ? '🎧 Listen to the audio version:' : '🎧 Аудіоверсія статті:'}</strong>
        <audio controls src={audioSrc}>
          {isEnglish ? 'Your browser does not support the audio element.' : 'Ваш браузер не підтримує аудіоелемент.'}
        </audio>
      </div>
    )}

    <div class="article-content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .article-audio {
    margin: 20px 0;
    padding: 12px 16px;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
  }

  .article-audio audio {
    display: block;
    width: 100%;
    margin-top: 8px;
  }
</style>